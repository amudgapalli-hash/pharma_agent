# ===================================
# .env.example - COPY TO .env AND FILL
# ===================================
# This file shows all environment variables needed.
# NEVER commit .env file - it contains secrets!
# 
# Usage:
# 1. Copy this file: cp .env.example .env
# 2. Fill in your actual values
# 3. .env is auto-ignored by .gitignore

# ===================================
# JWT SECURITY
# ===================================
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
JWT_SECRET=your-generated-secret-key-here-min-32-chars

# ===================================
# DATABASE
# ===================================
# SQLite (development): sqlite:///./pharma_audit_trail.db
# PostgreSQL (production): postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./pharma_audit_trail.db

# ===================================
# API CONFIGURATION
# ===================================
API_URL=http://localhost:8000
API_BACKEND=http://fastapi_backend:8000

# ===================================
# CORS - Allowed Origins
# ===================================
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:8501,http://localhost:3000,http://localhost:8000

# ===================================
# OLLAMA / LLM
# ===================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ===================================
# LANGSMITH (Optional - for tracing)
# ===================================
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=pharma-agent

# ===================================
# DATABASE CREDENTIALS (if using PostgreSQL)
# ===================================
POSTGRES_USER=sci_user
POSTGRES_PASSWORD=your-secure-password-here
POSTGRES_DB=compliance_db
POSTGRES_HOST=postgres_db
POSTGRES_PORT=5432

# ===================================
# STREAMLIT CONFIGURATION
# ===================================
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_LOGGER_LEVEL=info

# ===================================
# SECURITY SETTINGS
# ===================================
REQUIRE_HTTPS=false  # Set to true in production
LOG_LEVEL=INFO
DEBUG_MODE=false

# ===================================
# PRODUCTION SETTINGS
# ===================================
# Set to true when deploying to production
PRODUCTION_MODE=false
